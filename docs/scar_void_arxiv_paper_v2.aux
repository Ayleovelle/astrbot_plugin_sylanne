\newlabel{fig:cohomological_dissociation}{{7}{25}{Cohomological dissociation detection over 200 ticks. Inconsistency energy (S-curve, $0 \to 65$) and dissociation pressure ($0.19 \to 0.59$) grow under contradictory events, while $H^1$ stays 0 (full-rank presentation matrices prevent true cohomological obstruction)}{figure.7}{}}
\newlabel{fig:cohomological_dissociation@cref}{{[figure][7][]7}{[1][25][]25}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Exp 9: Spectral Propagation Verification.}{25}{section*.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Spectral propagation across 5 relationship types. Propagation strength ($\|P_j^T P_0\|_F$) decreases with relational distance: intimate (0.543) $>$ friendly (0.405) $>$ formal (0.314) $>$ adversarial (0.215), confirming Theorem~\ref {thm:sheaf-spectral}.}}{26}{figure.8}\protected@file@percent }
\newlabel{fig:spectral_propagation}{{8}{26}{Spectral propagation across 5 relationship types. Propagation strength ($\|P_j^T P_0\|_F$) decreases with relational distance: intimate (0.543) $>$ friendly (0.405) $>$ formal (0.314) $>$ adversarial (0.215), confirming Theorem~\ref {thm:sheaf-spectral}}{figure.8}{}}
\newlabel{fig:spectral_propagation@cref}{{[figure][8][]8}{[1][25][]26}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Exp 10: Triadic Irreducibility.}{26}{section*.27}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Triadic irreducibility across 8 dimensions (10 seeds). All dimensions show significant reconstruction residual (mean 0.62--0.79); total residual = 5.79, confirming irreducible triadic information not available from pairwise data.}}{27}{figure.9}\protected@file@percent }
\newlabel{fig:triadic_irreducibility}{{9}{27}{Triadic irreducibility across 8 dimensions (10 seeds). All dimensions show significant reconstruction residual (mean 0.62--0.79); total residual = 5.79, confirming irreducible triadic information not available from pairwise data}{figure.9}{}}
\newlabel{fig:triadic_irreducibility@cref}{{[figure][9][]9}{[1][26][]27}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{Exp 11: Personality Feedback Loop.}{27}{section*.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Personality feedback loop verification. Three conditions: (A) repeated wounding ($N\!\uparrow $, $O\!\downarrow $), (B) sustained acceptance ($E\!\uparrow $, $A\!\uparrow $), (C) cross-relational contradiction ($C\!\downarrow $). Drift is bounded and causally driven by computation state.}}{27}{figure.10}\protected@file@percent }
\newlabel{fig:personality_feedback}{{10}{27}{Personality feedback loop verification. Three conditions: (A) repeated wounding ($N\!\uparrow $, $O\!\downarrow $), (B) sustained acceptance ($E\!\uparrow $, $A\!\uparrow $), (C) cross-relational contradiction ($C\!\downarrow $). Drift is bounded and causally driven by computation state}{figure.10}{}}
\newlabel{fig:personality_feedback@cref}{{[figure][10][]10}{[1][27][]27}{}{}{}}
