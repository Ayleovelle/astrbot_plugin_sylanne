\@writefile{toc}{\contentsline {paragraph}{实验 8：上同调解离检测。}{19}{section*.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces 200 tick 上同调解离检测。不一致性能量（S 曲线，$0 \to 65$）和解离压力（$0.19 \to 0.59$）在矛盾事件下增长，而 $H^1$ 保持为 0（满秩呈现矩阵阻止了真正的上同调阻碍）。}}{20}{figure.7}\protected@file@percent }
\newlabel{fig:cohomological_dissociation}{{7}{20}{200 tick 上同调解离检测。不一致性能量（S 曲线，$0 \to 65$）和解离压力（$0.19 \to 0.59$）在矛盾事件下增长，而 $H^1$ 保持为 0（满秩呈现矩阵阻止了真正的上同调阻碍）。}{figure.7}{}}
\newlabel{fig:cohomological_dissociation@cref}{{[figure][7][]7}{[1][19][]20}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{实验 9：谱传播验证。}{20}{section*.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces 5 种关系类型的谱传播。传播强度（$\|P_j^T P_0\|_F$）随关系距离递减：亲密（0.543）$>$ 友好（0.405）$>$ 正式（0.314）$>$ 对抗（0.215），验证定理~\ref {thm:sheaf-spectral}。}}{20}{figure.8}\protected@file@percent }
\newlabel{fig:spectral_propagation}{{8}{20}{5 种关系类型的谱传播。传播强度（$\|P_j^T P_0\|_F$）随关系距离递减：亲密（0.543）$>$ 友好（0.405）$>$ 正式（0.314）$>$ 对抗（0.215），验证定理~\ref {thm:sheaf-spectral}。}{figure.8}{}}
\newlabel{fig:spectral_propagation@cref}{{[figure][8][]8}{[1][20][]20}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{实验 10：三元不可约性。}{20}{section*.27}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces 8 个维度（10 个种子）的三元不可约性。所有维度显示显著重构残差（均值 0.62--0.79）；总残差 = 5.79，确认仅从成对数据不可获得的不可约三元信息。}}{21}{figure.9}\protected@file@percent }
\newlabel{fig:triadic_irreducibility}{{9}{21}{8 个维度（10 个种子）的三元不可约性。所有维度显示显著重构残差（均值 0.62--0.79）；总残差 = 5.79，确认仅从成对数据不可获得的不可约三元信息。}{figure.9}{}}
\newlabel{fig:triadic_irreducibility@cref}{{[figure][9][]9}{[1][21][]21}{}{}{}}
\@writefile{toc}{\contentsline {paragraph}{实验 11：人格反馈闭环验证。}{21}{section*.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces 人格反馈闭环验证。三种条件下人格向量的漂移轨迹：(A) 反复受伤（$N\!\uparrow $，$O\!\downarrow $），(B) 持续接纳（$E\!\uparrow $，$A\!\uparrow $），(C) 跨关系矛盾（$C\!\downarrow $）。漂移有界且由计算状态因果驱动。}}{21}{figure.10}\protected@file@percent }
