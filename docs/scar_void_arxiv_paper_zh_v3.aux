\@writefile{toc}{\contentsline {subsection}{\numberline {9.6}实验 6：长期稳定性}{18}{subsection.9.6}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{结果。}{18}{section*.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces 1000 tick 长期稳定性。上：平均伤疤调制因子收敛至 0。中：伤疤计数线性增长（$\sim $3.14/tick）。下：空洞计数收敛于 $\sim $29。系统达到稳定均衡而无发散。}}{19}{figure.6}\protected@file@percent }
\newlabel{fig:stability}{{6}{19}{1000 tick 长期稳定性。上：平均伤疤调制因子收敛至 0。中：伤疤计数线性增长（$\sim $3.14/tick）。下：空洞计数收敛于 $\sim $29。系统达到稳定均衡而无发散。}{figure.6}{}}
