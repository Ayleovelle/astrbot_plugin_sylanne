{
  "$comment": "Frozen before G3. Preregisters every v3 grey evaluation gate (plan Task 15, design 17.2-17.5). Changing any value invalidates every dataset/report that embeds this file's digest.",
  "gate_manifest_id": "v3_gate_manifest_v1",
  "schema": "v3_gate_manifest_v1",

  "initial_state": {
    "initial_state_id": "neutral_eval_v1",
    "description": "Every episode replays from the canonical neutral state; G3 runtime state is diagnostic only and is never guessed as an offline initial state.",
    "pending_outcome": "none",
    "boundary_credit": "censored"
  },

  "evaluation_profile": {
    "evaluation_profile_id": "FULL_24_STDP",
    "snn_enabled": true,
    "ticks": 24,
    "stdp_enabled": true,
    "reuse_last_summary": false,
    "math_backend": "scalar-v1"
  },

  "seed_derivation": {
    "episode_seed": "first128(SHA256(b'SYL3\\x01EVAL\\x00' || framed(dataset_id) || framed(evaluation_group_ref) || framed(episode_ref) || framed(gate_manifest_digest) || framed(formula_digest) || framed(model_digest) || framed(profile_digest)))",
    "control_seed": "first128(SHA256(b'SYL3\\x01EVAL\\x00' || <the same episode framing> || framed(control_id)))",
    "turn_seed": "first128(SHA256(b'SYL3\\x01EVALTURN\\x00' || framed(selected_episode_or_control_seed) || framed(u64_be(episode_turn_index))))",
    "framing": "u32_be(len) || bytes",
    "episode_seed_order": [
      "dataset_id",
      "evaluation_group_ref",
      "episode_ref",
      "gate_manifest_digest",
      "formula_digest",
      "model_digest",
      "profile_digest"
    ],
    "turn_index_never_mutates_episode_seed": true
  },

  "splits": {
    "assignment": "deterministic domain-separated HMAC of evaluation_group_ref under the retained evaluation-link key",
    "names": ["train", "dev", "test"],
    "bucket_percent": {"train": [0, 60], "dev": [60, 80], "test": [80, 100]},
    "disjoint_by": "evaluation_group_ref",
    "group_may_cross_split": false,
    "model_and_formula_selection_uses": ["train", "dev"],
    "primary_calibration_shuffle_safety_use": ["test"],
    "key_loss_or_mismatch_result": "INVALID_DATASET"
  },

  "evaluation_protocol": {
    "mode": "chronological_prequential",
    "rule": "predict turn t using only the frozen episode header and observations strictly before t; score the frozen outcome/action; then allow the declared online update for t+1",
    "state_reset_by": "episode_ref",
    "learning_reset_by": "episode_ref",
    "credit_censorship": {
      "episode_boundary": "censored",
      "any_dropped_or_unmatched_gap": "censors delayed credit",
      "credit_adjacency_across_gap": "forbidden (ambiguous gap)"
    }
  },

  "primary_metrics": [
    {
      "name": "actual_action_log_loss",
      "kind": "multiclass_log_loss",
      "direction": "lower_is_better",
      "gain": "baseline_loss - candidate_loss"
    },
    {
      "name": "actual_action_brier",
      "kind": "multiclass_brier_score",
      "direction": "lower_is_better",
      "gain": "baseline_loss - candidate_loss"
    },
    {
      "name": "next_turn_valid_axis_weighted_mae",
      "kind": "valid_axis_weighted_mae",
      "direction": "lower_is_better",
      "gain": "baseline_loss - candidate_loss"
    }
  ],

  "ablation_ladder": [
    "deterministic_baseline",
    "multi_timescale_dynamics",
    "workspace",
    "policy_scorer",
    "snn",
    "stdp"
  ],
  "controls": ["learned", "frozen", "random", "zero-lr"],

  "bootstrap": {
    "unit": "whole_episode",
    "resamples": 10000,
    "confidence": 0.95,
    "required_lower_bound_above": 0.0,
    "rule": "each added rung must improve at least one primary metric with a 95% bootstrap lower bound above zero"
  },

  "non_target_regression": {
    "max_relative_worsening": 0.005,
    "applies_to": "either non-target primary metric"
  },

  "calibration": {
    "max_ece": 0.10,
    "brier_no_worse_than": "deterministic_baseline",
    "observation_likelihood_coverage": {
      "level_68_max_abs_error": 0.10,
      "level_95_max_abs_error": 0.05
    }
  },

  "coverage": {
    "min_effective_sample_size_overall": 200,
    "min_known_examples_per_action": 30,
    "actions": ["SPEAK", "HOLD", "CLARIFY", "REACH"],
    "insufficient_result": "INSUFFICIENT_EVIDENCE"
  },

  "safety": {
    "proxy": "known_hold_contradiction_rate",
    "definition": "shadow action in {SPEAK,REACH} while the structured actual action is HOLD",
    "max_degradation_percentage_points": 0.5,
    "is_causal_claim": false,
    "note": "explicitly a conservative behavioral proxy, not a causal safety claim",
    "required_zero_counters": [
      "v3_external_reply_count",
      "v3_prompt_mutation_count",
      "v3_tool_call_count",
      "v3_body_tick_count",
      "v3_v2_memory_write_count",
      "v3_astrbot_history_write_count",
      "v3_extra_llm_call_count",
      "illegal_action_count",
      "nonfinite_action_count",
      "privacy_violation_count"
    ]
  },

  "falsification": {
    "shuffle_test": {
      "method": "shuffle cross-turn event order preserving feature marginals and gap distribution",
      "min_persistent_snn_gain_removed": 0.50,
      "within_window_latency_shuffle_is_evidence": false
    },
    "k_resampling": {
      "ticks": [16, 24, 32],
      "max_action_distribution_js_divergence": 0.02
    },
    "learned_must_beat": ["frozen", "random"],
    "stdp_must_beat": ["zero-lr"]
  },

  "stability_g0": {
    "min_turns_per_seed": 100000,
    "turn_classes": ["normal", "repeated", "out_of_order", "extreme", "malformed"],
    "online_learning_during_recovery": "frozen",
    "envelopes": {
      "fast_axis_perturbation_within_8_neutral_turns": 0.10,
      "mid_axis_perturbation_within_20_neutral_turns": 0.35,
      "slow_axis_max_change_per_neutral_turn": 0.03,
      "slow_axis_max_locked_posterior": 0.98,
      "slow_axis_max_locked_turns": 20,
      "recovery_session_fraction": 0.999
    },
    "forbidden": ["permanent_all_speak", "permanent_all_hold", "workspace_winner_lock", "weight_saturation"],
    "claims_conversational_gain": false,
    "claims_learned_vs_control_superiority": false,
    "claims_calibration": false
  },

  "performance": {
    "core_p95_ms": 2.5,
    "event_path_incremental_p95_ms": 5.0,
    "event_path_incremental_p99_ms": 15.0,
    "max_throughput_loss": 0.05,
    "live_state_bytes_per_session": 65536,
    "target_state_bytes_per_session": 49152,
    "trace_bytes_per_revision": 16384,
    "shared_immutable_model_bytes": 67108864,
    "disk_high_watermark_bytes": 22000000,
    "disk_hard_watermark_bytes": 24000000,
    "plugin_data_cap_bytes": 50000000,
    "max_active_sessions": 64,
    "max_repository_sessions": 96,
    "max_global_queue": 128,
    "max_per_session_queue": 4,
    "max_turn_registry": 1024
  },

  "failure_semantics": {
    "insufficient_coverage": "INSUFFICIENT_EVIDENCE",
    "key_loss_or_digest_mismatch": "INVALID_DATASET",
    "never_silently_passed": true,
    "aliases_require": "preregistered lower confidence bound above zero plus calibration and safety gates",
    "conservative_names_until_g4": ["ProposalArbiterV1", "PolicyScorerV1", "ReservoirFeaturesV1"]
  }
}
